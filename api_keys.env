# =====================================================================
# API Keys & Model Config (Auto-loaded by run_pipeline.py / llm_client.py)
# Edit your key or model below and save -- no terminal `export` needed!
# =====================================================================

# Leave empty to automatically use ./harvey_lab_corpus/ inside harvey_synth_pipeline/
# (or set a custom folder/zip path if stored elsewhere):
CORPUS_PATH=""

TEACHER_API_KEY=""
TEACHER_MODEL="gemini-3.1-pro-preview"
TEACHER_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# API_FORMAT can be: auto | gemini | openai
API_FORMAT="auto"

# Optional separate Judge (leave empty to automatically reuse TEACHER_* above):
JUDGE_API_KEY=""
JUDGE_MODEL=""
JUDGE_BASE_URL=""

# Optional Student endpoint (only needed when running Stage 4-5 without --skip-student-eval):
STUDENT_API_KEY=""
STUDENT_MODEL=""
STUDENT_BASE_URL=""
